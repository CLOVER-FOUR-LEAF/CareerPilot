# ── 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=careerpilot
MYSQL_PASSWORD=cp123456

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=redis123456

# ── 认证 ────────────────────────────────────────────────────
# 生产必须换成长度 ≥ 32 字节的随机串
JWT_SECRET=careerpilot-default-secret-key-must-be-at-least-256-bits-long-for-hs256

# ── 网关 CORS ───────────────────────────────────────────────
# Docker 内部前端走 Nginx 同源反代，* 在这里只影响直连 8080 的场景
CORS_ALLOWED_ORIGINS=*

# ── LLM（可留空，全部 Agent 走纯规则引擎）───────────────────
OPENAI_API_KEY=
