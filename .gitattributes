# 默认按文本处理，收敛掉 Windows / Linux 的换行差异
* text=auto

# 源码与配置统一用 LF（Python / Shell 脚本在 Windows 上也按 LF 跑，避免 CRLF 引起的诡异问题）
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.py     text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.conf   text eol=lf

# Shell 脚本必须 LF；Windows 批处理保持 CRLF
*.sh     text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制，不做换行转换
*.jar    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
