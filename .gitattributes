# 默认按文本处理，收敛掉 Windows / Linux 的换行差异
* text=auto

# 源码与配置统一用 LF（容器里跑，避免 CRLF 引起的诡异问题）
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.py     text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.conf   text eol=lf
Dockerfile text eol=lf

# 这些必须是 LF，否则在 Linux 上直接跑不起来
*.sh     text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制，不做换行转换
*.jar    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
