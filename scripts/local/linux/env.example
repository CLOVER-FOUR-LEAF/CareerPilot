# CareerPilot Linux/Docker 本地环境配置
#   cp scripts/local/linux/env.example scripts/local/.env
#
# 与 scripts/local/.env.example（Windows 本机 MySQL）的区别：
# 这里的基础设施跑在 Docker 里，端口避开本机已有服务。

CAREERPILOT_DATA_DIR=./.runtime

# ── MySQL（容器 careerpilot-mysql）────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=careerpilot
MYSQL_PASSWORD=cp123456
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root123456
MYSQL_CONTAINER=careerpilot-mysql

# ── Redis（容器 careerpilot-redis）────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=redis123456
REDIS_CONTAINER=careerpilot-redis

# ── 网关 / 鉴权 ───────────────────────────────────────────────
JWT_SECRET=careerpilot-default-secret-key-must-be-at-least-256-bits-long-for-hs256
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# ── 服务间地址 ────────────────────────────────────────────────
AI_ORCHESTRATOR_URL=http://localhost:8001
AI_SCHEDULER_URL=http://localhost:8085
RESUME_SERVICE_URL=http://localhost:8082
JD_SERVICE_URL=http://localhost:8083

# user-center 默认 8081；若本机 8081 被占用，脚本会自动退避到 18081
USER_CENTER_PORT=18081

STORAGE_ROOT=./.runtime/uploads
OPENAI_API_KEY=
