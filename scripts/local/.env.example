# ─────────────────────────────────────────────────────────────
# CareerPilot 本地运行环境配置
#   cp scripts/local/.env.example scripts/local/.env   然后按需修改
# 复制后请把 .env 加入 .gitignore（仓库已默认忽略）
# ─────────────────────────────────────────────────────────────

# 数据目录：MySQL 数据文件等大文件放这里，不要放进仓库
CAREERPILOT_DATA_DIR=D:\CareerPilotData

# ── MySQL ──────────────────────────────────────────────────
# 3307 = 本项目专用实例（不占用你机器上已有的 3306）
# 若要改用你现有的 MySQL：把端口改成 3306，并把 MYSQL_USER/PASSWORD
# 改成该实例上真实存在的账号
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=careerpilot
MYSQL_PASSWORD=cp123456
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root123456

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ── 网关 / 鉴权 ─────────────────────────────────────────────
JWT_SECRET=careerpilot-default-secret-key-must-be-at-least-256-bits-long-for-hs256
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── 服务间调用地址（本地默认均为 localhost）─────────────────
AI_ORCHESTRATOR_URL=http://localhost:8001
AI_SCHEDULER_URL=http://localhost:8085
RESUME_SERVICE_URL=http://localhost:8082
JD_SERVICE_URL=http://localhost:8083

# ── AI Agent ───────────────────────────────────────────────
# 留空 = 纯规则引擎，所有 Agent 的主实现不依赖 LLM
OPENAI_API_KEY=

# ── 前端 ───────────────────────────────────────────────────
# 开发模式走 vite dev server；构建产物模式走 nginx / preview
FRONTEND_PORT=3000
